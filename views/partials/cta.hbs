<section class="section cta-section" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta">
      <div class="cta__text">
        <h2 class="cta__title" id="cta-title">{{#if title}}{{title}}{{else}}Запишіться на консультацію{{/if}}</h2>
        <p>{{#if text}}{{text}}{{else}}Оберіть зручний час онлайн або зателефонуйте — допомога починається вже в день звернення.{{/if}}</p>
        {{#if promo.enabled}}
        <p class="cta__promo"><i class="ph ph-tag" aria-hidden="true"></i> {{promo.title}}: {{promo.price}}. {{promo.note}}.</p>
        {{/if}}
      </div>
      <div class="cta__actions">
        <a class="btn btn--accent btn--lg" href="{{site.bookingUrl}}" target="_blank" rel="noopener">
          <i class="ph ph-calendar-check" aria-hidden="true"></i> Записатися на консультацію
        </a>
        <a class="btn btn--ghost-light btn--lg" href="{{site.phoneHref}}">
          <i class="ph ph-phone" aria-hidden="true"></i> {{site.phone}}
        </a>
      </div>
    </div>
  </div>
</section>
