{{#if promo.enabled}}
<div class="promo" role="note">
  <span class="promo__tag"><i class="ph ph-tag" aria-hidden="true"></i> {{promo.title}}</span>
  <p class="promo__price">{{promo.price}}</p>
  <p class="promo__note"><i class="ph ph-check-circle" aria-hidden="true"></i> {{promo.note}}</p>
</div>
{{/if}}
