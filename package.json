{
  "name": "ortopedia-vip",
  "version": "1.0.0",
  "private": true,
  "description": "Сайт медичного центру «Ортопедія VIP» — Nest.js + PostgreSQL",
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "seed": "node dist/database/seed.cli.js",
    "db:init": "node scripts/local-db.mjs init",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "export": "node scripts/export-static.mjs",
    "firebase:build": "npm run assets && npm run build && npm run seed && npm run export",
    "firebase:deploy": "npm run firebase:build && npx firebase-tools deploy --only hosting"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "compression": "^1.7.5",
    "hbs": "^4.2.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/manrope": "^5.1.0",
    "@nestjs/cli": "^11.0.0",
    "@phosphor-icons/web": "^2.1.1",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/hbs": "^4.0.5",
    "@types/node": "^22.0.0",
    "datatables.net": "^2.1.8",
    "datatables.net-dt": "^2.1.8",
    "datatables.net-responsive": "^3.0.3",
    "datatables.net-responsive-dt": "^3.0.3",
    "jquery": "^3.7.1",
    "sharp": "^0.33.5",
    "typescript": "^5.6.0"
  }
}
